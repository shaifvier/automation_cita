# Datos privados: copia este archivo a .env y sustituye los marcadores.
# Ejecutar: node --env-file=.env .\cita-regreso.cjs --browser=seleniumbase --una-consulta
CITA_NIE=REEMPLAZAR_NIE
CITA_NOMBRE="REEMPLAZAR NOMBRE Y APELLIDOS"

# Opcional: rellenar SOLO teléfono y correo (dos veces) después del aviso.
# Nunca envía este formulario ni selecciona una cita. Vacíos desactivan el relleno.
CITA_TELEFONO=
CITA_EMAIL=

# Avisos opcionales al móvil. Crea un bot con @BotFather y guarda su token aquí.
# Activa los avisos al ejecutar el monitor con --telegram; sin esa opción solo Windows.
# Enlace privado: node --env-file=.env scripts/setup-telegram.cjs
# Prueba sin consultar ICP+: node --env-file=.env cita-regreso.cjs --probar-telegram
CITA_TELEGRAM_TOKEN=
CITA_TELEGRAM_CHAT_ID=

# Solo necesarios con --certificado. Rutas absolutas; usa / en Windows.
CITA_CERT_PEM="C:/REEMPLAZAR/cert.pem"
CITA_KEY_PEM="C:/REEMPLAZAR/key.pem"
CITA_CERT_PASS_FILE="C:/REEMPLAZAR/.p12pass"

# Opcional: Python del entorno virtual creado en el repositorio.
# CITA_PYTHON="C:/ruta/a/automation_cita/.venv/Scripts/python.exe"
